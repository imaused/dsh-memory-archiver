{
  "name": "dsh-memory-archiver",
  "version": "0.1.2",
  "private": true,
  "description": "Approval-free memory archiving for the DSH memory convention: writes only inside configured memory roots, everything else is refused.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
